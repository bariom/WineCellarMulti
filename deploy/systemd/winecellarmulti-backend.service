[Unit]
Description=WineCellarMulti backend API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/home/administrator/progetti/WineCellarMulti/backend
Environment=PATH=/home/administrator/progetti/WineCellarMulti/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/administrator/progetti/WineCellarMulti/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
