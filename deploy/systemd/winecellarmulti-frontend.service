[Unit]
Description=WineCellarMulti PWA frontend
After=network-online.target winecellarmulti-backend.service
Wants=network-online.target

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/home/administrator/progetti/WineCellarMulti/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run preview:pwa
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
