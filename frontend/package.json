{
  "name": "winecellarmulti-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "build:monitor": "tsc -b && vite build --mode monitor",
    "android:monitor": "npm run build:monitor && npx cap sync android && npx cap open android",
    "test:help": "node scripts/check-help-content.mjs",
    "test:e2e": "playwright test",
    "test:e2e:wine-detail": "playwright test e2e/wine-detail.spec.ts",
    "test:e2e:update": "playwright test e2e/wine-detail.spec.ts --update-snapshots",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "preview:pwa": "vite preview --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
