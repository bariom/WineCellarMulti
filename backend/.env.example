APP_NAME=Vinaris
APP_ENV=production
APP_DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-long-random-password@localhost:5433/winecellarmulti
BACKUP_REMOTE_PATH=pcloud:VinarisBackups/postgres
LOCAL_BACKUP_RETENTION_DAYS=14
REMOTE_BACKUP_RETENTION_DAYS=30
SECRET_KEY=change-me
SESSION_COOKIE_NAME=winecellarmulti_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=7
TRIAL_ENTITLEMENT_DAYS=5
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30
COOWNERSHIP_INVITE_TTL_DAYS=30
REGISTRATION_REQUIRES_APPROVAL=true
# Public legal-document contact details. Configure all three before production deployment.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
CORS_ORIGINS=https://vinaris.app,https://www.vinaris.app,http://localhost:5173,http://127.0.0.1:5173
# Long random secret used only by the private monitoring dashboard. Leave empty to disable monitoring endpoints.
MONITORING_API_TOKEN=
OPENAI_API_KEY=
ARCGIS_API_KEY=
# Organization Admin API key used only by Admin > Operativita to read aggregate OpenAI costs.
# Never expose this value to the frontend. Leave empty to disable the cost summary.
OPENAI_ADMIN_KEY=
OPENAI_COSTS_CACHE_SECONDS=300
OPENAI_MODEL=gpt-5.4-mini
OPENAI_AI_NOTES_MODEL=gpt-5.4-mini
OPENAI_DRINK_WINDOW_MODEL=gpt-5.4
OPENAI_VALUE_MODEL=gpt-5.4-mini
OPENAI_GRAPE_MODEL=gpt-5.4-nano
OPENAI_WISHLIST_MODEL=gpt-5.4
OPENAI_PAIRING_MODEL=gpt-5.4
OPENAI_DEFAULT_MODEL=gpt-5.5
OPENAI_ECONOMY_MODEL=gpt-5.6-luna
OPENAI_BALANCED_MODEL=gpt-5.6-terra
OPENAI_ADVANCED_MODEL=gpt-5.6-sol
OPENAI_ENABLE_GPT56=false
OPENAI_ENABLE_MODEL_ROUTING=false
OPENAI_FALLBACK_MODEL=gpt-5.5
OPENAI_LEGACY_REASONING_EFFORT=low
OPENAI_ECONOMY_REASONING_EFFORT=low
OPENAI_BALANCED_REASONING_EFFORT=medium
OPENAI_ADVANCED_REASONING_EFFORT=high
OPENAI_LEGACY_MAX_OUTPUT_TOKENS=32768
OPENAI_ECONOMY_MAX_OUTPUT_TOKENS=12288
OPENAI_BALANCED_MAX_OUTPUT_TOKENS=32768
OPENAI_ADVANCED_MAX_OUTPUT_TOKENS=32768
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=0
# Optional JSON price-book overrides/additions, in USD per 1M tokens. Restart the backend after updating it.
# Example: OPENAI_MODEL_PRICING_USD_PER_MILLION_TOKENS={"gpt-new":{"input":"1.25","cached_input":"0.125","output":"10"}}
OPENAI_MODEL_PRICING_USD_PER_MILLION_TOKENS=
WINE_RECOGNITION_MAX_INPUT_BYTES=16000000
WINE_RECOGNITION_MAX_DIMENSION=1600
WINE_RECOGNITION_JPEG_QUALITY=88
WINE_RECOGNITION_TIMEOUT_SECONDS=45
WINE_PHOTO_STORAGE_DIR=data/wine-photos
WINE_PHOTO_AI_ENABLED=true
WINE_PHOTO_AI_MODEL=birefnet-general-lite
WINE_PHOTO_AI_MAX_INPUT_BYTES=12000000
# Each segmentation runs in a disposable worker so ONNX memory is released.
WINE_PHOTO_AI_TIMEOUT_SECONDS=90
# Keep the isolated model ready only while a photo capture is active.
WINE_PHOTO_AI_WORKER_IDLE_SECONDS=75
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_AI_CREDIT_PRICE_ID=
STRIPE_AI_CREDIT_AMOUNT_USD=5.00
STRIPE_AI_CREDIT_LABEL=Vinaris AI Pack
AI_PACK_MARKUP_PERCENT=15
OPENAI_WEB_SEARCH_TOOL_COST_USD=0
STRIPE_PAYMENT_AMOUNT_CENTS=0
STRIPE_PAYMENT_CURRENCY=chf
STRIPE_PAYMENT_LABEL=Vinaris access
STRIPE_ENTITLEMENT_DAYS=365
STRIPE_MONTHLY_ENTITLEMENT_DAYS=31
STRIPE_ANNUAL_ENTITLEMENT_DAYS=365
STRIPE_SUCCESS_URL=https://vinaris.app/?stripe_checkout=success
STRIPE_CANCEL_URL=https://vinaris.app/?stripe_checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://vinaris.app/?billing_portal=return
EMAIL_PROVIDER=smtp
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Vinaris
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Vinaris
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
OPERATIONS_ALERTS_ENABLED=true
OPERATIONS_ALERT_REMINDER_MINUTES=60
OPERATIONS_ALERT_CPU_WARNING_PERCENT=80
OPERATIONS_ALERT_CPU_CRITICAL_PERCENT=90
OPERATIONS_ALERT_MEMORY_WARNING_PERCENT=80
OPERATIONS_ALERT_MEMORY_CRITICAL_PERCENT=90
OPERATIONS_ALERT_DISK_WARNING_PERCENT=80
OPERATIONS_ALERT_DISK_CRITICAL_PERCENT=90
OPERATIONS_ALERT_CONNTRACK_WARNING_PERCENT=80
OPERATIONS_ALERT_CONNTRACK_CRITICAL_PERCENT=90
OPERATIONS_ALERT_LATENCY_WARNING_MS=750
OPERATIONS_ALERT_LATENCY_CRITICAL_MS=1500
