POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKUP_REMOTE_PATH=pcloud:VinarisBackups/vinaris
LOCAL_BACKUP_RETENTION_DAYS=14
REMOTE_BACKUP_RETENTION_DAYS=30
SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=production
APP_DEBUG=false
APP_NAME=Vinaris
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
CORS_ORIGINS=https://vinaris.app,https://www.vinaris.app,http://localhost:5173,http://127.0.0.1:5173
WINE_PHOTO_STORAGE_DIR=/data/wine-photos
# Host path, relative to this repository, included in complete backup bundles.
WINE_PHOTO_BACKUP_PATH=./backend/data/wine-photos
WINE_PHOTO_AI_ENABLED=true
WINE_PHOTO_AI_MODEL=birefnet-general-lite
WINE_PHOTO_AI_TIMEOUT_SECONDS=90
WINE_PHOTO_AI_WORKER_IDLE_SECONDS=75
SESSION_COOKIE_SECURE=true
TRIAL_ENTITLEMENT_DAYS=5
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30
COOWNERSHIP_INVITE_TTL_DAYS=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_IP_ATTEMPTS=20
RATE_LIMIT_LOGIN_ACCOUNT_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_VERIFY_EMAIL_ATTEMPTS=10
RATE_LIMIT_VERIFY_EMAIL_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=900
RATE_LIMIT_COOWNERSHIP_RESPONSE_ATTEMPTS=10
RATE_LIMIT_COOWNERSHIP_RESPONSE_WINDOW_SECONDS=900
RATE_LIMIT_PASSKEY_OPTIONS_ATTEMPTS=20
RATE_LIMIT_PASSKEY_VERIFY_ATTEMPTS=10
RATE_LIMIT_PASSKEY_WINDOW_SECONDS=300
RATE_LIMIT_SUPPORT_ATTEMPTS=5
RATE_LIMIT_SUPPORT_WINDOW_SECONDS=3600
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_AI_CREDIT_PRICE_ID=
STRIPE_AI_CREDIT_AMOUNT_USD=5.00
STRIPE_AI_CREDIT_LABEL=Vinaris AI Pack
AI_PACK_MARKUP_PERCENT=15
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.5
OPENAI_ECONOMY_MODEL=gpt-5.6-luna
WINE_RECOGNITION_MAX_INPUT_BYTES=16000000
WINE_RECOGNITION_MAX_DIMENSION=1600
WINE_RECOGNITION_JPEG_QUALITY=88
WINE_RECOGNITION_TIMEOUT_SECONDS=45
OPENAI_BALANCED_MODEL=gpt-5.6-terra
OPENAI_ADVANCED_MODEL=gpt-5.6-sol
OPENAI_ENABLE_GPT56=false
OPENAI_ENABLE_MODEL_ROUTING=false
OPENAI_FALLBACK_MODEL=gpt-5.5
# Fallback effort for unknown tasks. Vinaris classifies known AI calls automatically.
OPENAI_LEGACY_REASONING_EFFORT=
OPENAI_ECONOMY_REASONING_EFFORT=low
OPENAI_BALANCED_REASONING_EFFORT=medium
OPENAI_ADVANCED_REASONING_EFFORT=high
OPENAI_LEGACY_MAX_OUTPUT_TOKENS=32768
OPENAI_ECONOMY_MAX_OUTPUT_TOKENS=12288
OPENAI_BALANCED_MAX_OUTPUT_TOKENS=32768
OPENAI_ADVANCED_MAX_OUTPUT_TOKENS=32768
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=0
WINE_PULSE_ENABLED=true
WINE_PULSE_AI_ENABLED=true
WINE_PULSE_MODEL=gpt-5.6-luna
WINE_PULSE_MIN_SCORE=72
WINE_PULSE_MAX_DAILY_ARTICLES=10
WINE_PULSE_FEED_TIMEOUT_SECONDS=20
WINE_PULSE_RETENTION_DAYS=180
WINE_PULSE_SOURCES_JSON=
# Optional JSON price-book overrides/additions, in USD per 1M tokens. Restart the backend after updating it.
# Example: OPENAI_MODEL_PRICING_USD_PER_MILLION_TOKENS={"gpt-new":{"input":"1.25","cached_input":"0.125","output":"10"}}
OPENAI_MODEL_PRICING_USD_PER_MILLION_TOKENS=
OPENAI_WEB_SEARCH_TOOL_COST_USD=0.01
STRIPE_PAYMENT_AMOUNT_CENTS=0
STRIPE_PAYMENT_CURRENCY=chf
STRIPE_PAYMENT_LABEL=Vinaris access
STRIPE_ENTITLEMENT_DAYS=365
STRIPE_MONTHLY_ENTITLEMENT_DAYS=31
STRIPE_ANNUAL_ENTITLEMENT_DAYS=365
